position: 40 } ]\r\n  @UI.lineItem:       [ { position: 60, label: 'Última Alteração' } ]\r\n  @UI.fieldGroup:     [ { qualifier: 'idAdminDataGroup', position: 30 } ]\r\n  LocalLastChangedAt;\r\n\r\n  //──────────────────────────────────────────────────────────\r\n  // Arquivo\r\n  //──────────────────────────────────────────────────────────\r\n  @EndUserText.label: 'Arquivo'\r\n  @UI.selectionField: [ { position: 50 } ]\r\n  @UI.fieldGroup:     [ { position: 10, qualifier: 'idDemandDetailsGroup' } ]\r\n  FileContent;\r\n\r\n\r\n  //──────────────────────────────────────────────────────────\r\n  // Ultima Alteração\r\n  //──────────────────────────────────────────────────────────\r\n  @EndUserText.label: 'Alterado Por'\r\n  @UI.selectionField: [ { position: 50 } ]\r\n  @UI.fieldGroup:     [ { qualifier: 'idAdminDataGroup', position: 40 } ]\r\n  LocalLastChangedBy;\r\n\r\n  //──────────────────────────────────────────────────────────\r\n  // Tipo do Arquivo\r\n  //──────────────────────────────────────────────────────────\r\n  @UI.hidden: true\r\n  Mimetype;\r\n}"
