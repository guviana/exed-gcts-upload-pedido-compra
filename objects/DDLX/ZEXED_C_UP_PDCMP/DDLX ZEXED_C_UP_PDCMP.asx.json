    "SOURCE":"@Metadata.layer: #CORE\r\n@UI: { headerInfo: { typeName:       'Carga Pedidos de Compra',\r\n                     typeNamePlural: 'Carga Pedidos de Compra',\r\n                  typeImageUrl: 'sap-icon://excel-attachment',\r\n                     title: { type: #STANDARD, value: 'Filename' } } }\r\n\r\n@UI.lineItem: [ { criticality: 'CriticalityStatus' } ] // Destaca a cor do crit. no inicio da linha\r\nannotate view ZEXED_C_UP_PDCMP with\r\n{\r\n  @UI.facet: [\r\n  {\r\n    id: 'idEndUser',\r\n    purpose: #HEADER,\r\n    position: 10,\r\n    type: #DATAPOINT_REFERENCE,\r\n    targetQualifier: 'tqEndUser'\r\n  },\r\n  {\r\n    id: 'idStatus',\r\n    purpose: #HEADER,\r\n    position: 20,\r\n    type: #DATAPOINT_REFERENCE,\r\n    targetQualifier: 'tqStatus'\r\n  },\r\n  {\r\n    id: 'idChgAt',\r\n    purpose: #HEADER,\r\n    position: 30,\r\n    type: #DATAPOINT_REFERENCE,\r\n    targetQualifier: 'tqChgAt'\r\n  },\r\n  {\r\n    id: 'idGeneralInfo',\r\n    purpose: #STANDARD,\r\n    label: 'Informações Gerais',\r\n    type: #COLLECTION,\r\n    position: 10\r\n  },\r\n  {\r\n     id: 'idDemandDetails',\r\n     parentId: 'idGeneralInfo',\r\n     type: #FIELDGROUP_REFERENCE,\r\n     label: 'Detalhes da Carga',\r\n     position: 10,\r\n     targetQualifier: 'idDemandDetailsGroup'\r\n  },\r\n  {\r\n     id: 'idAdminData',\r\n     parentId: 'idGeneralInfo',\r\n     type: #FIELDGROUP_REFERENCE,\r\n     label: 'Dados Administrativos',\r\n     position: 20,\r\n     targetQualifier: 'idAdminDataGroup'\r\n  },\r\n  {\r\n    id: 'idContentInfo',\r\n    purpose: #STANDARD,\r\n    label: 'Dados do Arquivo',\r\n    type: #COLLECTION,\r\n    position: 20\r\n  },\r\n  {\r\n    id: 'idContentTable',\r\n    parentId: 'idContentInfo',\r\n    purpose:  #STANDARD,\r\n    type:     #LINEITEM_REFERENCE,\r\n    position: 10,\r\n    targetElement: '_PurchaseOrders'\r\n  }\r\n  ]\r\n\r\n  @UI.hidden: true\r\n  UUID;\r\n\r\n//  @UI.lineItem: [ { position: 10, label: 'Icone' } ]\r\