    "SOURCE":"@AccessControl.authorizationCheck: #NOT_REQUIRED\n@EndUserText.label: 'Consumption View for zexed_I_UP_PDCMP_H'\n@Metadata.allowExtensions: true\n@Metadata.ignorePropagatedAnnotations: false\n@VDM.viewType: #CONSUMPTION\n@Search.searchable: true\ndefine view entity ZEXED_C_UP_PDCMP_H\n  as projection on ZEXED_I_UP_PDCMP_H\n{\n  key   UUID,\n        ParentUUID,\n        Status,\n        CriticalityStatus,\n        PurchaseOrder,\n        LabelPurchaseOrder,\n        @Consumption.valueHelpDefinition: [{\n          entity: { name: 'I_PurchasingDocumentType', element: 'PurchasingDocumentType' },\n          useForValidation: true,\n          additionalBinding: [\n              { element: 'PurchasingDocumentCategory', localConstant: 'F', usage: #FILTER }\n          ]\n        }]\n        PurchaseOrderType2,\n        PurchaseOrderDate,\n        @Consumption.valueHelpDefinition: [{\n          entity: { name: 'I_CompanyCode', element: 'CompanyCode' },\n          useForValidation: true,\n          additionalBinding: [\n              { element: 'CompanyCodeName', localElement: 'CompanyName', usage: #RESULT }\n          ]\n        }]\n        @Search.defaultSearchElement: true\n        @Search.fuzzinessThreshold: 0.8\n        @ObjectModel.text.element: [ 'CompanyName' ]\n        @UI.textArrangement: #TEXT_FIRST\n        CompanyCode,\n        @Consumption.valueHelpDefinition: [{\n          entity: { name: 'I_PurchasingOrganization', element: 'PurchasingOrganization' },\n          useForValidation: true,\n          additionalBinding: [\n              { element: 'PurchasingOrganizationName', localElement: 'PurchaseOrganizationName', usage: #RESULT }\n          ]\n        }]\n        @Search.defaultSearchElement: true\n        @Search.fuzzinessThreshold: 0.8\n        @ObjectModel.text.element: [ 'PurchaseOrganizationName' ]\n        @UI.textArrangement: #TEXT_FIRST\n        PurchaseOrganization,\n        @Consumption.valueHelpDefinition: [{\n          entity: { name: 'I_PurchasingGroup', element: 'PurchasingGroup' },\n          useForValidation: true,\n          additionalBinding: [\n              { element: 'PurchasingGroupName', localElement: 'PurchaseGroupName', usage: #RESULT }\n          ]\n        }]\n        @Search.defaultSearchElement: true\n        @Search.fuzzinessThreshold: 0.8\n        @ObjectModel.text.element: [ 'PurchaseGroupName' ]\n        @UI.textArrangement: #TEXT_FIRST\n        PurchaseGroup,\n        @Consumption.valueHelpDefinition: [{\n          entity: { name: 'I_Supplier', element: 'Supplier' },\n          useForValidation: true,\n          additionalBinding: [\n              { element: 'BPSupplierFullName', localElement: 'SupplierName', usage: #RESULT }\n          ]\n        }]\n        @Search.defaultSearchElement: true\n        @Search.fuzzinessThreshold: 0.8\n        @ObjectModel.text.element: [ 'SupplierName' ]\n        @UI.textArrangement: #TEXT_LAST\n        Supplier,\n        @Consumption.valueHelpDefinition: [{\n          entity: { name: 'I_PaymentTerms', element: 'PaymentTerms' },\n          useForValidation: true\n        }]\n        @Search.defaultSearchElement: true\n        @Search.fuzzinessThreshold: 0.8\n        PaymentTerms,\n        MiroHeaderText,\n        CompanyName,\n        SupplierName,\n        PurchaseOrganizationName,\n        PurchaseGroupName,\n        NameUserCreate,\n        @Search.defaultSearchElement: true\n        @Search.fuzzinessThreshold: 0.8\n        @ObjectModel.text.element: [ 'NameUserCreate' ]\n        @UI.textArrangement: #TEXT_FIRST\n        LocalCreatedBy,\n        LocalCreatedAt,\n        NameUserChange,\n        @ObjectModel.text.element: [ 'NameUserChange' ]\n        @UI.textArrangement: #TEXT_FIRST\n        LocalLastChangedBy,\n        LocalLastChangedAt,\n        LastChangedAt,\n        /* Associations */\n        _File  : redirected to parent ZEXED_C_UP_PDCMP,\n        _Itens : redirected to composition child ZEXED_C_UP_PDCMP_I\n}\n/*+[internal] {\n\"B